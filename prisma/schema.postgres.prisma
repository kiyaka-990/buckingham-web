// Production schema — PostgreSQL (Neon / Vercel Postgres).
// Local dev uses prisma/schema.prisma (SQLite). Models are identical.
// Vercel build runs: prisma generate/migrate deploy --schema=prisma/schema.postgres.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (Neon pgbouncer)
  directUrl = env("DIRECT_URL")   // direct connection for migrations
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String?
  role         String   @default("client")
  image        String?
  createdAt    DateTime @default(now())
}

model Dog {
  id          String   @id
  slug        String   @unique
  name        String
  breedSlug   String
  breedName   String
  category    String
  sex         String
  ageLabel    String
  color       String
  price       Int
  compareAt   Int?
  status      String   @default("available")
  stock       Int      @default(1)
  featured    Boolean  @default(false)
  bestseller  Boolean  @default(false)
  weightKg    Float
  rating      Float    @default(4.8)
  reviews     Int      @default(0)
  location    String
  description String
  images      String
  traits      String
  pedigree    String
  health      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  ref             String      @unique
  customerName    String
  email           String
  phone           String?
  address         String?
  city            String?
  county          String?
  method          String      @default("Card (Stripe)")
  status          String      @default("pending")
  total           Int
  deposit         Int         @default(0)
  stripeSessionId String?     @unique
  mpesaCheckoutId String?
  mpesaReceipt    String?
  paidAt          DateTime?
  createdAt       DateTime    @default(now())
  items           OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  dogSlug   String
  name      String
  breedName String
  price     Int
  qty       Int     @default(1)
  image     String?
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  channel   String   @default("Web Form")
  subject   String
  body      String
  unread    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

/// One-time sign-in codes emailed to a visitor. Codes are stored hashed,
/// expire after 10 minutes, and are consumed on first successful use.
model LoginCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}
