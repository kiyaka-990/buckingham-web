// Production schema — PostgreSQL (Neon / Vercel Postgres).
// Local dev uses prisma/schema.prisma (SQLite). Models are identical.
// Vercel build runs: prisma generate/migrate deploy --schema=prisma/schema.postgres.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (Neon pgbouncer)
  // Neon's Vercel integration supplies both of these automatically.
  directUrl = env("DATABASE_URL_UNPOOLED") // direct connection, used for migrations
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String?
  role         String   @default("client")
  image        String?
  createdAt    DateTime @default(now())
}

model Dog {
  id          String   @id
  slug        String   @unique
  name        String
  breedSlug   String
  breedName   String
  category    String
  sex         String
  ageLabel    String
  color       String
  price       Int
  compareAt   Int?
  status      String   @default("available")
  stock       Int      @default(1)
  featured    Boolean  @default(false)
  bestseller  Boolean  @default(false)
  weightKg    Float
  rating      Float    @default(4.8)
  reviews     Int      @default(0)
  location    String
  description String
  images      String
  traits      String
  pedigree    String
  health      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  ref             String      @unique
  customerName    String
  email           String
  phone           String?
  address         String?
  city            String?
  county          String?
  method          String      @default("Card (Stripe)")
  status          String      @default("pending")
  total           Int
  deposit         Int         @default(0)
  stripeSessionId String?     @unique
  mpesaCheckoutId String?
  mpesaReceipt    String?
  paidAt          DateTime?
  createdAt       DateTime    @default(now())
  items           OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  dogSlug   String
  name      String
  breedName String
  price     Int
  qty       Int     @default(1)
  image     String?
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  channel   String   @default("Web Form")
  subject   String
  body      String
  unread    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

/// One-time sign-in codes emailed to a visitor. Codes are stored hashed,
/// expire after 10 minutes, and are consumed on first successful use.
model LoginCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

/// Everything an AI agent did on the kennel's behalf.
///
/// Agent writes are not the same as a visitor filling in a form, and they must
/// not be indistinguishable from one in the Message table. Every tool call that
/// changes state lands here: what ran, for whom, what it touched, and whether a
/// human still needs to approve it.
model AgentAction {
  id         String   @id @default(cuid())
  agent      String   @default("duke")
  action     String
  status     String   @default("done") // "done" | "pending_approval" | "rejected" | "failed"
  sessionId  String?
  orderRef   String?
  dogSlug    String?
  contact    String?
  summary    String
  payload    String // JSON object
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([orderRef])
  @@index([status])
}

/// A puppy held off the market while a buyer completes payment.
///
/// Distinct from stock: stock only moves when money confirms. A hold is the
/// soft, expiring claim an agent or a checkout can place so two buyers are not
/// sold the same puppy in the same ten minutes.
model Hold {
  id        String   @id @default(cuid())
  dogSlug   String
  orderRef  String?
  source    String   @default("agent") // "agent" | "checkout"
  contact   String?
  expiresAt DateTime
  releasedAt DateTime?
  createdAt DateTime @default(now())

  @@index([dogSlug])
  @@index([expiresAt])
}

/// A person who showed real buying intent, and where they are in the pipeline.
///
/// Distinct from Message, which is an inbox item — a thing somebody reads once
/// and ticks off. A Lead is a record the marketing agent works over time: it
/// carries what they want, how warm they are, how many times we have already
/// contacted them, and when it is fair to do so again.
model Lead {
  id           String    @id @default(cuid())
  name         String
  email        String
  phone        String?
  source       String    @default("chat") // "chat" | "form" | "checkout"
  stage        String    @default("new")  // new | qualified | nurturing | hot | won | lost | unsubscribed
  score        Int       @default(0)      // 0-100, set by the agent at capture
  interest     String?
  breedSlug    String?
  dogSlug      String?
  budgetUsd    Int?
  location     String?
  notes        String?
  orderRef     String?
  /// Outbound touches so far. Hard-capped — see MAX_TOUCHES.
  touches      Int       @default(0)
  lastTouchAt  DateTime?
  nextTouchAt  DateTime?
  /// Set the moment someone opts out. Nothing outbound may ever go to a lead
  /// with this set, regardless of stage.
  unsubscribedAt DateTime?
  /// Unguessable token for the one-click unsubscribe link in every email.
  optOutToken  String    @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@index([stage])
  @@index([nextTouchAt])
}

/// One visitor's conversation with Duke, kept so the owner can read it.
///
/// Distinct from Lead (a pipeline record) and Message (an inbox item): this is
/// the transcript itself, keyed by a session id the widget generates, so every
/// person who chats is on file even if they never become a lead.
model ChatSession {
  id              String   @id // generated by the widget, validated server-side
  name            String?
  email           String?
  phone           String?
  turns           Int      @default(0)
  lastUserMessage String?
  transcript      String // JSON [{ role, content, at }]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([email])
  @@index([updatedAt])
}
